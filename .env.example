# OpenAI — used for STT (gpt-4o-transcribe) and TTS (gpt-4o-mini-tts)
OPENAI_API_KEY=

# Anthropic — used for Claude Code agent
ANTHROPIC_API_KEY=

# Agent mode: set to 'false' to use Anthropic Messages API instead of Claude Agent SDK.
# Default (true): uses Claude Agent SDK for full code agent capabilities
# (file read/edit, bash, grep, etc.)
USE_AGENT_SDK=true

# Optional: rate limit (requests per minute per IP)
RATE_LIMIT_RPM=30
